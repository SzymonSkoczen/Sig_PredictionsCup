# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Predictions Cup (The Super Market) API ---
# Create the key on the site: My Profile -> API Keys, scopes `read` + `trade`.
# You must also have confirmed your email, registered for the tournament and accepted
# the current Terms, otherwise every call returns 403.
SIG_API_KEY=
SIG_BASE_URL=https://www.thesuper.market/api/v1
# Tournament slug, from the tournament URL on the site (`sigcup check` lists them).
SIG_TOURNAMENT_SLUG=
# Account limit is 100 reads + 30 writes per minute across ALL keys/processes.
# Leave headroom for clicking around the website yourself.
READ_BUDGET=70
WRITE_BUDGET=20

# --- Mode ---
# paper = simulate fills, never send orders. live = real orders (also needs `sigcup run --live`).
MODE=paper
POLL_SECONDS=10
# Create this file (or run `sigcup kill`) to stop all NEW entries instantly. Exits keep running.
KILL_SWITCH=KILL
DB_PATH=data/sigcup.db
MAP_PATH=data/market_map.csv

# --- Reference markets (real money; public data, no account needed) ---
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
REF_REFRESH_SECONDS=20
# Ignore reference quotes older than this
REF_MAX_AGE_SECONDS=120
# Ignore a reference whose bid/ask spread is wider than this (it is not a reliable price)
REF_MAX_SPREAD=0.06
# Skip a market if two references disagree by more than this
REF_MAX_DISAGREEMENT=0.05
REF_MIN_SOURCES=1

# --- Entry: SIG mispriced vs the reference fair value ---
# Minimum edge (fair - price paid) per share to open, in probability points
MIN_EDGE=0.04
# Fraction-Kelly sizing on the bankroll below
KELLY_FRACTION=0.25
BANKROLL=100000
# Hard caps in SUSQies of cost
MAX_ORDER_COST=2500
MAX_MARKET_COST=6000
MAX_TOTAL_COST=60000
# Keep this much cash untouched
CASH_RESERVE=10000
# Take at most this share of each visible book level
DEPTH_FRACTION=0.5
# Seconds an order may rest before expiring. Short = behaves like immediate-or-cancel.
ORDER_TTL_SECONDS=15
# At most this many order books fetched per cycle (each is one API read)
MAX_BOOKS_PER_CYCLE=6

# --- Exit: sell when SIG converges to the reference ---
# Sell once SIG's bid is within this of fair value
EXIT_BAND=0.01
# Bail out if fair value falls this far below what we paid (thesis wrong / news)
STOP_LOSS=0.08
# Close anything held longer than this (hours). 0 = never.
MAX_HOLD_HOURS=72
# Worst price below the touch accepted when force-exiting (stop / timeout)
EXIT_SLIPPAGE=0.02
# Stop opening new trades for the rest of the UTC day after losing this much
DAILY_LOSS_STOP=8000

# --- Reports (every REPORT_INTERVAL_HOURS) and alerts ---
REPORT_INTERVAL_HOURS=2
# Fill in any of the channels below; every configured channel receives each report.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# https://ntfy.sh — free phone push notifications, just pick an unguessable topic name
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
