# Non-secret settings for the scheduled cloud runs (docs/CLOUD_RUN.md).
# SIG_API_KEY is NOT here: it comes from the cloud environment's variables/secrets.
MODE=live
# Paper trading until midnight Irish time on 22 Oct, live afterwards (if the paper run was healthy)
LIVE_FROM=2026-10-23T00:00:00+01:00
PAPER_MIN_CYCLES=30
DB_PATH=state/sigcup.db
MAP_PATH=state/market_map.csv
KILL_SWITCH=state/KILL
POLL_SECONDS=10
REPORT_INTERVAL_HOURS=2
ARB_MIN_PROFIT=0.02
ARB_MAX_SETS=500

# --- Owner-approved 2026-10-27: hold to election day, keep cash for election night ---
# Gap trades = buy the side Kalshi says the Cup underprices, hold until the race settles.
HOLD_TO_SETTLEMENT=true
MAX_HOLD_HOURS=0
STOP_LOSS=0.10
MIN_EDGE=0.03
BANKROLL=97000
MAX_ORDER_COST=4000
MAX_MARKET_COST=5000
MAX_RACE_COST=5000
MAX_TOTAL_COST=75000
CASH_RESERVE=2000
# 20k untouchable until polls start closing (6pm ET = 23:00 UTC on 3 Nov), then free to trade
ELECTION_RESERVE=20000
ELECTION_NIGHT_START=2026-11-03T23:00:00Z
# Arb baskets: only buy with a 2+ point locked profit, hold to settlement (no time-limit sales)
ARB_MAX_HOLD_HOURS=0
ARB_MAX_CAPITAL=15000
ARB_CASH_FLOOR=0
# Fewer Kalshi 429s
REF_REFRESH_SECONDS=30

# --- Owner-approved 2026-10-28: grissou/prediction-market-maker strategy (src/sigcup/value.py) ---
# Rank and hurdle every buy by return on cash, (fair - price) / price
MIN_RETURN=0.05
RACE_SCALE=true
# At most 15k per state across all its markets (grissou's Rhode Island lesson)
STATE_MAX_COST=15000
# Harvest ladder: resting bids under favourites at 0/2/4/6c below the bid, 8%+ edge, 3k per level, 15k total
LADDER_ENABLED=true
LADDER_FAVOURITE_P=0.90
# Owner-approved 2026-10-31: bids at and just under the touch; 2-6c-deep bids never filled (28-31 Oct)
LADDER_OFFSETS=0,0.01,0.02
LADDER_NEAR_FIRST=true
LADDER_MIN_EDGE=0.08
LADDER_LEVEL_COST=3000
LADDER_BUDGET=15000
LADDER_REQUOTE_SECONDS=900
# Ladder may use 10k of the 20k election reserve until 1h before election night
LADDER_FROM_RESERVE=10000
# Allocator: hourly, sell holdings with <=5% edge left (never >3c under fair) for buys 5+ points better
ALLOC_ENABLED=true
ALLOC_INTERVAL_SECONDS=3600
ALLOC_MIN_GAIN=0.05
ALLOC_MAX_KEEP_EDGE=0.05
ALLOC_SELL_MARGIN=0.03
ALLOC_MAX_TURNOVER=15000
# Election night (Bowen26 rule): buy called races (references bid 0.95+) while the Cup lags 2c+
NIGHT_ENABLED=true
NIGHT_MIN_REF_BID=0.95
NIGHT_MIN_GAP=0.02
NIGHT_RACE_COST=8000
NIGHT_POLL_SECONDS=4
NIGHT_REF_REFRESH_SECONDS=5
# Trading locks at noon ET on 4 Nov; stop 15 min before (grissou stop_minutes_before_close)
TRADING_CLOSE=2026-11-04T17:00:00Z
CLOSE_BUFFER_MINUTES=15
